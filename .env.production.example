AGENT_ENVIRONMENT=production
AGENT_LOG_LEVEL=INFO

AGENT_LLM_PROVIDER=openai_compatible
AGENT_LLM_MODEL=replace-with-text-model
AGENT_LLM_BASE_URL=https://replace-with-provider-endpoint/v1
AGENT_LLM_API_KEY=replace-with-secret
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_OUTPUT_TOKENS=1200
AGENT_LLM_THINKING=disabled

AGENT_LLM_VISION_PROVIDER=openai_compatible
AGENT_LLM_VISION_MODEL=replace-with-vision-model
AGENT_LLM_VISION_BASE_URL=https://replace-with-provider-endpoint/v1
AGENT_LLM_VISION_API_KEY=replace-with-secret
AGENT_LLM_VISION_THINKING=false

AGENT_AUTH_ENABLED=true
AGENT_API_TOKEN=replace-with-a-long-random-token
AGENT_RATE_LIMIT_ENABLED=true
AGENT_RATE_LIMIT_REQUESTS=30
AGENT_RATE_LIMIT_WINDOW_SECONDS=60

AGENT_PRELOAD_EMBEDDING_MODEL=true
AGENT_CONVERSATION_MAX_TURNS=6
AGENT_CONVERSATION_MAX_SESSIONS=1000
AGENT_CONVERSATION_DB_PATH=data/runtime/conversations.db
AGENT_SUPPORT_DB_PATH=data/runtime/support.db
