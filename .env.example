# 基础运行环境
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO

# 大模型配置
# 现在先使用mock，下一阶段换成真实模型。
AGENT_LLM_PROVIDER=mock
AGENT_LLM_MODEL=mock
AGENT_LLM_TIMEOUT_SECONDS=30

# 接入真实模型时再取消注释并填写。
# AGENT_LLM_BASE_URL=
# AGENT_LLM_API_KEY=

# 检索参数
AGENT_SEMANTIC_TOP_K=20
AGENT_SEED_TOP_K=10
AGENT_NEIGHBOR_WINDOW_SIZE=1
AGENT_MAX_RETRIEVAL_RESULTS=20

# 上下文参数
AGENT_MAX_CONTEXT_CHARS=10000
AGENT_MAX_TEXT_CHARS=1200

AGENT_LLM_MAX_OUTPUT_TOKENS=1200
AGENT_LLM_THINKING=disabled
AGENT_MAX_ANSWER_IMAGES=3


# 接口认证目前先关闭，后续按照赛题要求启用。
AGENT_AUTH_ENABLED=false
# AGENT_API_TOKEN=

# 会话记忆
AGENT_CONVERSATION_MAX_TURNS=6
AGENT_CONVERSATION_MAX_SESSIONS=1000