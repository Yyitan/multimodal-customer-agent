# 基础运行环境
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO

# 大模型配置
# mock 适合本地测试；真实服务改为 openai 或 openai_compatible。
AGENT_LLM_PROVIDER=mock
AGENT_LLM_MODEL=mock
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_RETRY_BASE_SECONDS=0.5
AGENT_LLM_RETRY_MAX_SECONDS=4
AGENT_LLM_CIRCUIT_FAILURE_THRESHOLD=5
AGENT_LLM_CIRCUIT_RECOVERY_SECONDS=30

# 接入真实模型时再取消注释并填写。
# AGENT_LLM_BASE_URL=
# AGENT_LLM_API_KEY=

# 视觉预分析模型（上传图片时使用）
AGENT_LLM_VISION_PROVIDER=openai_compatible
# AGENT_LLM_VISION_MODEL=
# AGENT_LLM_VISION_BASE_URL=
# AGENT_LLM_VISION_API_KEY=
AGENT_LLM_VISION_THINKING=false

# 检索参数
AGENT_SEMANTIC_TOP_K=20
AGENT_SEED_TOP_K=10
AGENT_NEIGHBOR_WINDOW_SIZE=1
AGENT_MAX_RETRIEVAL_RESULTS=20

# 上下文参数
AGENT_MAX_CONTEXT_CHARS=10000
AGENT_MAX_TEXT_CHARS=1200

# API 输入安全限制（字节）
AGENT_MAX_QUESTION_CHARS=4000
AGENT_MAX_IMAGE_BYTES=4194304
AGENT_MAX_TOTAL_IMAGE_BYTES=10485760
AGENT_MAX_IMAGE_PIXELS=20000000
AGENT_MAX_REQUEST_BYTES=16777216
AGENT_PRELOAD_EMBEDDING_MODEL=true

# 问答接口限流（生产环境应启用）
AGENT_RATE_LIMIT_ENABLED=false
AGENT_RATE_LIMIT_REQUESTS=30
AGENT_RATE_LIMIT_WINDOW_SECONDS=60

AGENT_LLM_MAX_OUTPUT_TOKENS=1200
AGENT_LLM_THINKING=disabled
AGENT_MAX_ANSWER_IMAGES=3


# 本地开发可关闭；生产环境必须开启。
AGENT_AUTH_ENABLED=false
# AGENT_API_TOKEN=

# 会话记忆
AGENT_CONVERSATION_MAX_TURNS=6
AGENT_CONVERSATION_MAX_SESSIONS=1000
AGENT_CONVERSATION_DB_PATH=data/conversations.db
AGENT_SUPPORT_DB_PATH=data/support.db
